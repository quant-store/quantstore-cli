{
  "catalog_id": "product/twitter-monitor/gateway",
  "product_slug": "twitter-monitor",
  "schema_version": 2,
  "revision": 1,
  "min_cli_version": "0.1.0",
  "mode": "native",
  "scopes": [
    {"code": "tweets.read", "description": "Read matching tweets"}
  ],
  "operations": [
    {
      "operation_id": "tweets.get",
      "surface_id": "data-rest",
      "protocol": "rest",
      "method": "GET",
